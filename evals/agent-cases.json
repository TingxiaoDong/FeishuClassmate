      ],
      "expect": {
        "tools_any": [
          "cos_table"
        ],
        "actions_any": [
          "create_table"
        ],
        "confirm": false,
        "state": [
          {
            "path": "/tables",
            "contains": "器材借用登记"
          }
        ]
      }
    },
    {
