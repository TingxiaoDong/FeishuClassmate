# ClassmateOS 新栈环境配置

# ===== 大模型（OpenAI 兼容接口） =====
# 直连 DeepSeek 时填写 DEEPSEEK_API_KEY；自定义服务填写 LLM_BASE_URL + LLM_API_KEY。
DEEPSEEK_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
CLASSMATE_MODEL=deepseek-chat

# ===== ClassmateOS 平台 =====
CLASSMATE_OS_PORT=8080
CLASSMATE_OS_URL=http://127.0.0.1:8080/api/v1
CLASSMATE_OS_BOT_TOKEN=dev-bot-token

# ===== Temi（没有真机时保持模拟） =====
TEMI_MOCK=1
CLASSMATE_ROBOT_M4=1
