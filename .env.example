# 复制成 .env 再填写（.env 不会提交到 git）。

# ===== 大模型 =====
# 方式一：直连 DeepSeek
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
CLASSMATE_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 方式二：经 MetaClaw 代理（把上面 LLM_PROVIDER 改成 metaclaw）
# METACLAW_URL=http://127.0.0.1:30000/v1
# METACLAW_API_KEY=

# ===== ClassmateOS 平台（本机开发） =====
CLASSMATE_OS_PORT=8080
CLASSMATE_OS_URL=http://localhost:8080/api/v1
CLASSMATE_OS_BOT_TOKEN=dev-bot-token

# ===== Temi（没有真机时保持模拟） =====
TEMI_MOCK=1
CLASSMATE_ROBOT_M4=1
